{
    "name": "elrayn/table-export",
    "description": "Export arrays or query results to Excel or PDF with one consistent API",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Rayhan"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpoffice/phpspreadsheet": "^1.9"
    },
    "suggest": {
        "dompdf/dompdf": "Required if you use asPdf() (^2.0.9, or ^3.0 on PHP 8.1+)"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "Elrayn\\TableExport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elrayn\\TableExport\\Tests\\": "tests/"
        }
    }
}
